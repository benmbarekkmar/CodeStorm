# HackFlow environment template.
# Copy to `.env` and fill real values. `.env` is git-ignored; this file is not.
#
# NOTE: config/settings.py loads this `.env` file automatically (python-dotenv),
# and values already present in the real process environment take precedence.
# So the variables below do not need to be exported manually, e.g.:
#   uv run python manage.py runserver
#
# Do NOT commit real secret values.

# --- Google Gemini (AI analyses, Free Tier only) ---------------------------
# Required to run an analysis. Without these, analyses report a configuration
# error. Keep this on the Free Tier: do NOT buy credits or enable billing.
GEMINI_API_KEY=
# You MUST set this to a model id that your Google AI Studio dashboard lists as
# available on the Free Tier (no billing) for THIS project. Google publishes the
# current free-tier roster and its per-model rate limits (RPM / requests-per-day
# / TPM) dynamically in AI Studio and states they are not guaranteed, so verify
# in AI Studio before relying on this value: https://aistudio.google.com/
# Leaving this empty would override the default in config/settings.py with a
# blank model, so set it explicitly.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override of the API base URL (defaults to the v1beta REST endpoint).
GEMINI_BASE_URL=

# --- PostgreSQL (matches docker-compose.yml) -------------------------------
POSTGRES_DB=hackflow
POSTGRES_USER=hackflow
POSTGRES_PASSWORD=hackflow
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SECRET_KEY=SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
